<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>depth_to_pointcloud</name>
  <version>0.2.0</version>
  <description>
    Subscribes to a Gazebo (gz-transport) depth image and camera_info,
    back-projects pixels into 3D, and publishes a ROS2 PointCloud2.
  </description>

  <maintainer email="you@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <!-- gz-transport / gz-msgs are system deps, not ament packages -->
  <build_depend>gz-transport13</build_depend>
  <build_depend>gz-msgs10</build_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>